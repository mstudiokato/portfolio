# Skopiuj ten plik do .env.local i uzupełnij wartości.
# .env.local NIE trafia do repo (jest w .gitignore). Te same klucze wpisz
# na Vercel: Project → Settings → Environment Variables (środowisko Production).

# Resend — wysyłka maili z formularza (https://resend.com → API Keys)
RESEND_API_KEY=

# Cloudflare Turnstile — antyspam (https://dash.cloudflare.com → Turnstile)
# Secret key (serwerowy) i Site key (publiczny, ląduje w przeglądarce).
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Cal.com — link do umawiania rozmów (np. https://cal.com/eu/michal-stezaly/30min)
NEXT_PUBLIC_CAL_LINK=

# Kanoniczny adres strony — używany przez middleware do kanonizacji hosta
# panelu Keystatic (OAuth na stabilnej domenie, nie na deploy-preview URL).
NEXT_PUBLIC_URL=https://michal-stezaly.vercel.app

# Keystatic CMS (panel /keystatic). Lokalnie (dev) NIE są potrzebne — panel
# działa w trybie "local" bez logowania. Na produkcji (github mode) WYMAGANE
# wszystkie trzy poniżej (brak któregokolwiek → 500 na /keystatic):
# GitHub App OAuth (https://keystatic.com/docs/github-mode) + losowy sekret.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
# Losowy sekret do szyfrowania sesji — MIN. 32 znaki. Wygeneruj własny:
#   openssl rand -hex 32     (lub: node -e "console.log(require('crypto').randomBytes(40).toString('hex'))")
KEYSTATIC_SECRET=
